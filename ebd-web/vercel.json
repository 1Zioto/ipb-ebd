{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ebd-web && npm install && npm run build",
  "outputDirectory": "ebd-web/dist/ebd-web/browser",
  "framework": "angular",
  "rewrites": [
    {
      "source": "/mobile",
      "destination": "/mobile/index.html"
    },
    {
      "source": "/mobile/:path((?!.*\\.).*)",
      "destination": "/mobile/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
